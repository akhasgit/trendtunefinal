# OpenAI (required for agentic chat and embeddings)
OPENAI_API_KEY=

# xAI (required for Grok-based trend search endpoints)
XAI_API_KEY=

# Firebase Admin — use ONE of the following:
# Path to service account JSON file:
GOOGLE_APPLICATION_CREDENTIALS=/path/to/firebase-service-account.json
# Or inline JSON string (useful for Cloud Run):
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
